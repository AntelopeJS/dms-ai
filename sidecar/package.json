{
  "name": "@antelopejs/dms-ai-sidecar",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "dms-ai-sidecar": "dist/index.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests --exclude tests/integration/codex-acceptance.test.ts",
    "test:acceptance": "vitest run tests/integration/codex-acceptance.test.ts",
    "generate:codex-types": "node scripts/generate-codex-types.mjs",
    "test:e2e": "echo 'no e2e yet' && exit 0",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@anthropic-ai/claude-code": "^2.1.302",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.2.11",
    "@openai/codex": "0.154.0",
    "@types/node": "^22.19.15",
    "@types/ws": "^8.5.12",
    "knip": "^6.34.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
