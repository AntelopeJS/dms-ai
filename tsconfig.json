{
  "compilerOptions": {
    // tsgolint resolves node: builtins to an error type acting as `any`
    // without this, which makes every type-aware rule blind to them.
    "types": ["node"],
    "moduleResolution": "nodenext",
    "target": "esnext",
    "module": "nodenext",
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "sourceMap": true,
    "useDefineForClassFields": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@antelopejs/dms-ai/*": ["./src/*"]
    },
    "rootDir": "src"
  },
  "include": ["./src/**/*.ts"]
}
