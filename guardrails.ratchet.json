{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 4,
    "antelopejs/no-presence-only-type-guard": 3,
    "anti-slop/no-known-value-widening": 1,
    "anti-slop/no-runtime-typeof": 4,
    "anti-slop/no-unknown-parameters": 5,
    "anti-slop/no-unknown-returns": 2,
    "anti-slop/no-unsafe-dictionary-type": 2,
    "anti-slop/require-safety-comment-for-type-assertion": 18,
    "typescript/no-unsafe-argument": 84,
    "typescript/no-unsafe-assignment": 261,
    "typescript/no-unsafe-return": 93,
    "typescript/use-unknown-in-catch-callback-variable": 8
  },
  "oversizeFiles": {}
}
