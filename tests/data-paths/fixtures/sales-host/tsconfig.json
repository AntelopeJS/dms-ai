{
  "compilerOptions": {
    "types": ["node"],
    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "commonjs",
    "lib": ["esnext"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "removeComments": true,
    "rootDir": "src"
  },
  "include": ["./src/**/*.ts"]
}
