{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../..",
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "typeRoots": ["../../../node_modules/@types"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "composite": false,
    "noEmit": true,
    "incremental": false
  },
  "include": ["*.mjs"]
}
