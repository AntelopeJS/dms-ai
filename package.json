{
  "name": "@antelopejs/dms-ai",
  "version": "0.10.2",
  "description": "Deprecated: replaced by @antelopejs/dms-assistant, which brings the AI assistant and its onboarding. The builder engine and mockups ship in @antelopejs/dms (development only).",
  "keywords": [
    "ai",
    "antelopejs",
    "assistant",
    "claude-code",
    "codex",
    "dms",
    "dms-module"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/ai",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-ai/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-ai.git"
  },
  "files": [
    "dist",
    "frontend-vue",
    "skills",
    "sidecar/dist",
    "sidecar/package.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "build:sidecar": "pnpm --dir sidecar run build",
    "prepack": "pnpm run build && pnpm run build:sidecar",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "dev": "cd playground && pnpm dev",
    "lint": "pnpm run --reporter=append-only \"/^lint:(oxlint|frontend|rules)$/\"",
    "lint:oxlint": "oxlint",
    "lint:frontend": "pnpm --dir frontend-vue lint",
    "lint:rules": "node node_modules/@antelopejs/dms/frontend-vue/scripts/check-api-error-presentation.mjs frontend-vue/app && antelopejs-check-interface-ranges && node scripts/check-playground-install.mjs && node scripts/check-i18n.mjs",
    "lint:fix": "oxlint --fix && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "typecheck": "pnpm run --reporter=append-only \"/^typecheck:/\"",
    "typecheck:module": "tsc --noEmit",
    "typecheck:chat": "pnpm --dir frontend-vue typecheck:chat",
    "typecheck:sidecar": "pnpm --dir sidecar exec tsc --noEmit",
    "typecheck:sidecar-tests": "pnpm --dir sidecar exec tsc -p tsconfig.test.json",
    "test": "pnpm run test:node",
    "test:node": "([ -n \"$DMS_PREBUILT\" ] || pnpm run build) && node --test \"tests/!(sidecar-build).test.cjs\"",
    "test:sidecar-smoke": "pnpm run build:sidecar && node --test tests/sidecar-build.test.cjs",
    "test:frontend-registration": "pnpm run build && node --test tests/frontend-registration.test.cjs",
    "test:channels": "pnpm run build && node --test tests/channels.test.cjs tests/channel-limits.test.cjs",
    "test:routes": "pnpm run build && node --test tests/routes.test.cjs tests/banner-routes.test.cjs tests/database-routes.test.cjs",
    "test:spawn-args": "node --test tests/spawn-args.test.cjs",
    "test:sidecar-lifecycle": "node --test tests/sidecar-lifecycle.test.cjs",
    "test:build-id": "node --test tests/build-id.test.cjs",
    "test:e2e": "cd sidecar && pnpm test:e2e",
    "release": "pnpm install --frozen-lockfile && release-it",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "knip": "knip --dependencies && pnpm --dir sidecar knip",
    "knip:all": "knip",
    "prepare": "if [ -e .git ] && command -v git >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1 && GIT_DIR=.git GIT_WORK_TREE=. git rev-parse --git-dir >/dev/null 2>&1; then GIT_DIR=.git GIT_WORK_TREE=. lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "format:check": "oxfmt --check .",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/agent-skills": "^0.1.0",
    "@antelopejs/interface-api": ">=0.3.0 <1.0.0",
    "@antelopejs/interface-core": ">=0.4.0 <1.0.0",
    "@antelopejs/interface-dms": ">=0.12.0 <1.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@anthropic-ai/claude-code": "^2.1.316",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@antelopejs/dms": ">=0.19.1 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.3.0 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.6.1 <1.0.0",
    "@antelopejs/interface-database": ">=0.3.1 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.2.1 <1.0.0",
    "@antelopejs/tooling-configs": "^0.5.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mongodb-memory-server": "^11.3.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.0",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@openai/codex": "0.166.0"
  },
  "peerDependenciesMeta": {
    "@openai/codex": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@antelopejs/interface-database-catalog": ">=0.0.1 <1.0.0",
    "@antelopejs/interface-dms-builder": ">=0.4.0 <1.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [],
    "skills": [
      "./skills"
    ],
    "docs": {
      "standard": true
    }
  },
  "deprecated": "Replaced by @antelopejs/dms-assistant. See https://github.com/AntelopeJS/dms-ai#readme for the upgrade steps.",
  "dmsFrontend": "dist/frontend-module.js"
}
