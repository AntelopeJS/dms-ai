{
  "name": "@antelopejs/dms-ai",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-ai.git"
  },
  "files": [
    "dist",
    "frontend-vue",
    "skills",
    "sidecar/dist",
    "sidecar/chatbox/dist",
    "sidecar/package.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "build:sidecar": "cd sidecar && pnpm install && pnpm run build:all",
    "prepack": "pnpm run build && pnpm run build:sidecar",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "dev": "cd playground && pnpm dev",
    "lint": "oxlint --disable-nested-config && oxfmt --disable-nested-config --check . && cd frontend-vue && pnpm lint && cd ../sidecar && pnpm lint",
    "lint:fix": "oxlint --disable-nested-config --fix --max-warnings=1000000 && oxfmt --disable-nested-config . && cd frontend-vue && pnpm lint:fix && cd ../sidecar && pnpm lint:fix",
    "typecheck": "tsc --noEmit && cd frontend-vue && pnpm typecheck && cd ../sidecar && pnpm typecheck",
    "test": "cd sidecar && pnpm test && cd ../frontend-vue && pnpm test",
    "test:sidecar-smoke": "pnpm run build:sidecar && node --test tests/sidecar-build.test.cjs",
    "test:frontend-registration": "pnpm run build && node --test tests/frontend-registration.test.cjs",
    "test:spawn-args": "node --test tests/spawn-args.test.cjs",
    "test:release-script": "node --test tests/release-script.test.cjs",
    "test:e2e": "cd sidecar && pnpm test:e2e",
    "release": "pnpm --dir frontend-vue install --frozen-lockfile && pnpm --dir sidecar install --frozen-lockfile && pnpm --dir sidecar/chatbox install --frozen-lockfile && release-it",
    "format": "oxfmt --disable-nested-config . && cd frontend-vue && pnpm format",
    "knip": "knip --dependencies",
    "knip:all": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": "0.0.13",
    "@antelopejs/interface-core": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-dms": ">=0.0.1 <1.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.131",
    "@anthropic-ai/claude-code": "^2.1.131",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": ">=0.0.6 <1.0.0",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@openai/codex": "0.154.0"
  },
  "peerDependenciesMeta": {
    "@openai/codex": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@antelopejs/interface-dms-builder": ">=0.0.1 <1.0.0"
  },
  "packageManager": "pnpm@10.2.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [],
    "skills": [
      "./skills"
    ]
  }
}
