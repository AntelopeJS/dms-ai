{
  "name": "@antelopejs/dms-ai",
  "version": "0.7.0",
  "description": "AI development assistant for the AntelopeJS DMS: a chat panel next to every page and a coding agent that edits the project in reviewable, undoable change sets.",
  "keywords": [
    "ai",
    "antelopejs",
    "assistant",
    "claude-code",
    "codex",
    "dms",
    "dms-module"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/ai",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-ai/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-ai.git"
  },
  "files": [
    "dist",
    "frontend-vue",
    "skills",
    "sidecar/dist",
    "sidecar/package.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "build:sidecar": "pnpm --dir sidecar run build",
    "prepack": "pnpm run build && pnpm run build:sidecar",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "dev": "cd playground && pnpm dev",
    "lint": "oxlint && pnpm --dir frontend-vue lint && antelopejs-check-interface-ranges && node scripts/check-playground-install.mjs && node scripts/check-i18n.mjs",
    "lint:fix": "oxlint --fix && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "typecheck": "tsc --noEmit && pnpm --dir frontend-vue typecheck:chat && pnpm --dir sidecar typecheck",
    "test": "pnpm run test:node",
    "test:node": "([ -n \"$DMS_PREBUILT\" ] || pnpm run build) && node --test \"tests/!(sidecar-build).test.cjs\"",
    "test:sidecar-smoke": "pnpm run build:sidecar && node --test tests/sidecar-build.test.cjs",
    "test:frontend-registration": "pnpm run build && node --test tests/frontend-registration.test.cjs",
    "test:channels": "pnpm run build && node --test tests/channels.test.cjs tests/channel-limits.test.cjs",
    "test:routes": "pnpm run build && node --test tests/routes.test.cjs tests/banner-routes.test.cjs tests/database-routes.test.cjs",
    "test:spawn-args": "node --test tests/spawn-args.test.cjs",
    "test:sidecar-lifecycle": "node --test tests/sidecar-lifecycle.test.cjs",
    "test:build-id": "node --test tests/build-id.test.cjs",
    "test:e2e": "cd sidecar && pnpm test:e2e",
    "release": "pnpm install --frozen-lockfile && release-it",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "knip": "knip --dependencies && pnpm --dir sidecar knip",
    "knip:all": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check",
    "format:check": "oxfmt --check .",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-api": "file:.campaign/tgz/antelopejs-interface-api-f206be7.tgz",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-dms": "file:.campaign/tgz/antelopejs-interface-dms-3eb021e.tgz",
    "@anthropic-ai/claude-agent-sdk": "^0.2.131",
    "@anthropic-ai/claude-code": "^2.1.131",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@antelopejs/interface-api-util": "file:.campaign/tgz/antelopejs-interface-api-util-cc740f8.tgz",
    "@antelopejs/interface-data-api": "file:.campaign/tgz/antelopejs-interface-data-api-26c36e9.tgz",
    "@antelopejs/interface-database": "file:.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
    "@antelopejs/interface-database-decorators": "file:.campaign/tgz/antelopejs-interface-database-decorators-e79a62b.tgz",
    "@antelopejs/tooling-configs": "^0.2.17",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@openai/codex": "0.154.0"
  },
  "peerDependenciesMeta": {
    "@openai/codex": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@antelopejs/interface-database-catalog": ">=0.0.1 <1.0.0",
    "@antelopejs/interface-dms-builder": ">=0.2.3 <1.0.0"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-api": "file:.campaign/tgz/antelopejs-interface-api-f206be7.tgz",
      "@antelopejs/interface-api-util": "file:.campaign/tgz/antelopejs-interface-api-util-cc740f8.tgz",
      "@antelopejs/interface-database": "file:.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
      "@antelopejs/interface-database-decorators": "file:.campaign/tgz/antelopejs-interface-database-decorators-e79a62b.tgz",
      "@antelopejs/interface-data-api": "file:.campaign/tgz/antelopejs-interface-data-api-26c36e9.tgz",
      "@antelopejs/interface-dms": "file:.campaign/tgz/antelopejs-interface-dms-3eb021e.tgz"
    }
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [],
    "skills": [
      "./skills"
    ]
  },
  "dmsFrontend": "dist/frontend-module.js"
}
