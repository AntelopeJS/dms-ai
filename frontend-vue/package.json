{
	"name": "@antelopejs/dms-ai-frontend-vue",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.6.5",
	"scripts": {
		"build": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" build",
		"typecheck": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" typecheck",
		"format": "prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@inertiajs/vue3": "^3.7.0",
		"vue": "^3.5.18"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"typescript-eslint": "^8.0.0",
		"eslint": "^9.0.0",
		"eslint-plugin-vue": "^10.0.0",
		"globals": "^16.0.0",
		"@vitest/runner": "^4.1.5",
		"jsdom": "^29.1.1",
		"prettier": "^3.5.3",
		"typescript": "^5.8.2",
		"vitest": "^4.1.5",
		"vue-tsc": "^3.1.1"
	}
}
